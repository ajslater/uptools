#!/usr/bin/env bash
# prune the gems installed on top of ruby that no other gem depends on
#
# RubyGems has no leaves command and records nothing about why a gem was
# installed, so the leaves are worked out from the runtime dependencies of
# every installed gem and each one is asked about. The default and bundled
# gems that ship with ruby belong to the ruby install (see gemup) and are
# never offered, but what they depend on counts; rubygems-update is left to
# `gem update --system`. gem uninstall is told to take every version and the
# executables without asking and to refuse, rather than ask, when another gem
# still depends on the gem, so nothing can prompt.
#
# usage: gemprune [-n] [-a|-y] [-p]    see prunelib for the flags
set -euo pipefail

# shellcheck source=prunelib
source "$(dirname "$0")/prunelib"

# gems leaves|installed: the gems installed on top of ruby, the leaves among
# them with their summaries or all of their names. -W0: with duplicate copies
# of ruby's own gems present (see gemdedup) ruby would warn on every load.
gems() {
  ruby -W0 - "$1" <<'EOF'
# the names in specs that no spec in specs depends on, less ruby's own
def leaves(specs, own)
  needed = specs.flat_map { |s| s.runtime_dependencies.map(&:name) }
  specs.map(&:name).uniq - own - needed
end

# ruby's own gems: the default and bundled ones it ships, and rubygems-update
ruby_dir = File.join(RbConfig::CONFIG["rubylibprefix"], "gems", RbConfig::CONFIG["ruby_version"])
own = Dir[File.join(ruby_dir, "specifications", "{,default/}*.gemspec")]
  .filter_map { |f| Gem::Specification.load(f)&.name } + ["rubygems-update"]
specs = Gem::Specification.to_a
if ARGV[0] == "installed"
  puts(specs.map(&:name).uniq - own)
else
  latest = specs.group_by(&:name).transform_values { |v| v.max_by(&:version) }
  leaves(specs, own).sort.each do |name|
    puts [name, "unknown", latest[name].summary.to_s.gsub(/\s+/, " ").strip].join("\t")
  end
end
EOF
}

leaves() { gems leaves; }
installed() { gems installed; }
remove() { gem uninstall -ax --abort-on-dependent "$@"; }
info() {
  gem specification "$1" description
  gem dependency "^$1$" -R
}
PRUNE_WHAT="gems installed on top of ruby"
PRUNE_KEEP=gem
ALWAYS_KEEP=(rubygems-update)
prune_main "$@"
