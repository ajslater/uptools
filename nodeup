#!/usr/bin/env bash
# update bun's global node packages
set -euo pipefail

# shellcheck source=uptitle
source "$(dirname "$0")/uptitle"

title node
# Without BUN_INSTALL, bun keeps its global packages under XDG_CACHE_HOME when
# that is set, so a shell that sets one but not the other would update (or
# install into) an empty set. Pin the dir the interactive shell uses.
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
bun update -g

# npm keeps a global set of its own that bun never sees, so a package added
# with `npm i -g` would go stale here unnoticed. npm and corepack ship with
# node; anything else belongs in bun (bun add -g ...; npm uninstall -g ...).
npm_root="$(npm root -g)"
stray="$(npm ls -g --depth=0 --parseable | sed -n "s|^$npm_root/||p" | grep -vx -e npm -e corepack || true)"
if [[ -n $stray ]]; then
  echo "Installed with npm, not bun, so not updated: ${stray//$'\n'/ }"
fi
