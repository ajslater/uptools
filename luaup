#!/usr/bin/env bash
# Updates lua rocks
set -euo pipefail

# shellcheck source=uptitle
source "$(dirname "$0")/uptitle"

title lua
# luarocks install accepts a single rock, so upgrade outdated rocks one at a time.
luarocks list --outdated --porcelain | awk '{ print $1 }' |
  while read -r rock; do
    luarocks install "$rock"
  done
