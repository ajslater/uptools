#!/usr/bin/env bash
# update ruby gems
set -euo pipefail

# shellcheck source=uptitle
source "$(dirname "$0")/uptitle"

title ruby
# grep -v exits 1 when it filters out every line, which pipefail would report
# as a failure, so only gem's own exit status may fail the pipeline.
gem update --system | { grep -v "Latest version already installed. Done." || true; }

# The default and bundled gems that ship with ruby belong to the ruby install
# and are upgraded with it by homebrew. A bare `gem update` installs newer
# copies beside them, and every gem command then loads both rdoc plugins
# ("already initialized constant" warnings) and trips over copies whose
# extensions were built for an older macOS ("Ignoring ... because its
# extensions are not built"). So only update gems installed on top of ruby,
# and leave rubygems-update to `gem update --system` above.
mapfile -t gems < <(ruby -e '
  ruby_dir = File.join(RbConfig::CONFIG["rubylibprefix"], "gems", RbConfig::CONFIG["ruby_version"])
  shipped = Dir[File.join(ruby_dir, "specifications", "{,default/}*.gemspec")]
    .filter_map { |f| Gem::Specification.load(f)&.name }
  puts Gem::Specification.map(&:name).uniq - shipped - ["rubygems-update"]
')
if ((${#gems[@]})); then
  gem update "${gems[@]}" | { grep -v "Updating installed gems" || true; }
else
  echo "Nothing to update"
fi
