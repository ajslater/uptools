#!/usr/bin/env bash
# update all perl packages
set -uo pipefail

# shellcheck source=uptitle
source "$(dirname "$0")/uptitle"

title perl

# Run every perl tool with homebrew's perl explicitly: their shebangs may point
# at system perl, and homebrew perl's own site_perl is already in its @INC.
BREW_PERL_PREFIX="$(brew --prefix perl)"
BREW_PERL="${BREW_PERL_PREFIX}/bin/perl"
CPANM=("$BREW_PERL" "$(command -v cpanm)")
CPAN_OUTDATED=("$BREW_PERL" "${BREW_PERL_PREFIX}/bin/cpan-outdated")

# Homebrew keeps CPAN modules inside perl's Cellar, so upgrading perl discards
# them along with cpan-outdated. Look for it there rather than on PATH, where a
# stale copy built for another perl may linger.
if [[ ! -x ${CPAN_OUTDATED[1]} ]]; then
  echo "App::cpanoutdated not found. Installing via cpanm..."
  "${CPANM[@]}" App::cpanoutdated
fi

# Fetch the CPAN index once. -p prints package names, which cpanm accepts.
OUTDATED="$("${CPAN_OUTDATED[@]}" -p)"

# If DB_File is among the outdated packages, export paths to berkeley-db so
# the XS build can find the headers and library.
if grep -qx DB_File <<<"$OUTDATED"; then
  echo "DB_File upgrade detected — configuring berkeley-db build paths..."
  BERKELEY_PREFIX="$(brew --prefix berkeley-db)"
  export LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}${BERKELEY_PREFIX}/lib"
  export CPATH="${CPATH:+$CPATH:}${BERKELEY_PREFIX}/include"
fi

# cpan -u
"${CPANM[@]}" <<<"$OUTDATED"
