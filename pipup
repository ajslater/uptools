#!/usr/bin/env bash
# Updates python packages
set -euo pipefail

# shellcheck source=uptitle
source "$(dirname "$0")/uptitle"

title python
VENV="$HOME/.venv"
# Relink the venv to the current python and refresh the updater.
python3 -m venv --upgrade "$VENV"
"$VENV/bin/pip" install -Uq pip pip-review

# PyICU builds from source against homebrew's icu4c.
if "$VENV/bin/pip" show PyICU &>/dev/null; then
  ICU_PREFIX="$(brew --prefix)/opt/icu4c"
  [[ -d $ICU_PREFIX ]] || brew install icu4c
  export LDFLAGS="-L$ICU_PREFIX/lib"
  export CPPFLAGS="-I$ICU_PREFIX/include"
  export PKG_CONFIG_PATH="$ICU_PREFIX/lib/pkgconfig"
fi

"$VENV/bin/pip-review" --auto
